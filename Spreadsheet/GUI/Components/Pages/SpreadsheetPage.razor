@namespace GUI.Client.Pages
@page "/"
@page "/sheets"
@using System.Diagnostics
@using Microsoft.JSInterop
@rendermode InteractiveServer
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<PageTitle>Spreadsheet</PageTitle>


<span>
    <button class="btn btn-primary" @onclick="SaveFile">Save</button>
    <label>Load </label><InputFile type="file" OnChange="HandleFileChooser" />
    <br />

    <label>Selected Cell:</label>
        <input @bind="SelectedCell" readonly size="2"/>

    <label>Contents:</label>
    <input @bind-value="CurrentContents" @bind-value:event="oninput" type="text" @ref="TextArea" 
        placeholder="Enter contents" @onchange ="CellContentChanged" />
    
    <label>Value:</label>
    <input class="@GetTextClass(CurrentValue)" @bind="CurrentValue" readonly />

    <label>Choose Cell Color: </label>
        <input type="color" @bind="SelectedColor" />
</span>

<div>
    <div class="table-container">
        <div class="scrollable">
            <table class="table table-bordered">
                <thead>
                    <tr class="fixed-header">
                        <th scope="col">&nbsp;</th>
                        @for ( int col = 0; col < COLS; col++ )
                        {
                            <th scope="col">@Alphabet[col]</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @for ( int row = 0; row < ROWS; row++ )
                    {
                        <tr style="padding:0px !important;">
                            <th style="padding:0px !important;" scope="row" class="fixed-column">@(row + 1)</th>
                            @for ( int col = 0; col < COLS; col++ )
                            {
                                int r = row;
                                int c = col;

                                <td @onclick="() => CellClicked(r,c)" class="@(IsSelectedCell(r, c) ? "focus-outline" : "")"
                                    style="background-color: @CellColors[r, c]; padding:0px !important;">
                                    <p class="spreadcell @GetTextClass(CellsBackingStore[r, c])">
                                        @CellsBackingStore[r, c]
                                    </p>

                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (ShowError)
{
    <div class="error-box">
        <p style="font-size:18px;">Invalid Formula</p>
        <button class="error-button" @onclick="HideError">OK</button>
    </div>
}

@code{

    /// <summary>
    ///     Stores the colors of the cells.
    /// </summary>
    private string[,] CellColors { get; set; } = new string[ROWS, COLS];

    /// <summary>
    ///     Private member variable that holds the color of the selected cell; default is white.
    /// </summary>
    private string selectedColor = "#ffffff";

    /// <summary>
    ///     Property of the selected color. When the selected color is changed, meaning the cell is changed
    ///     color, the value of CellColors at the selected cell is updated accordingly.
    /// </summary>
    private string SelectedColor
    {
        get { return selectedColor; }
        set
        {
            selectedColor = value;
            CellColors[SelectedRow, SelectedCol] = selectedColor;
            spreadsheet.SetCellColor(SelectedCell, selectedColor);
        }
    }

    /// <summary>
    ///     When the page is first loaded, set all of the cell colors to white.
    /// </summary>
    protected override void OnInitialized()
    {
        for (int row = 0; row < ROWS; row++)
        {
            for (int col = 0; col < COLS; col++)
            {
                CellColors[row, col] = "#ffffff";
            }
        }
    }

    /// <summary>
    ///     When the page is first loaded, this method ensures that the Contents input box, referred to by
    ///     TextArea, is focused, so the user can start typing things without having to click on anything.
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await TextArea.FocusAsync();
        }
    }

    /// <summary>
    ///     Changes the text color of the displayed values if the contents of the selected results in a
    ///     FormulaError as the value.
    /// </summary>
    /// <param name="value"> the value of the selected cell </param>
    /// <returns>
    ///     the text class, either "red-text" if value is a FormulaError, or an empty string if otherwise.
    /// </returns>
    private string GetTextClass(string value)
    {
        if (value == "Formula Error")
        {
            return "red-text";
        }
        return "";
    }

    /// <summary>
    ///     Determines if a cell is the SelectedCell so that an outline can appear around the cell.
    /// </summary>
    /// <param name="row">The row component of a cell's coordinates</param>
    /// <param name="col">The column component of a cell's coordinates</param>
    /// <returns> true if the cell described by its coordinates is the selected cell, false if otherwise.</returns>
    private bool IsSelectedCell(int row, int col)
    {
        return row == SelectedRow && col == SelectedCol;
    }

    /// <summary>
    ///     Hides error box that appears for an invalid formula.
    /// </summary>
    private void HideError()
    {
        ShowError = false;
        CurrentContents = GetCurrentContents();
        StateHasChanged();
        TextArea.FocusAsync();
    }
}

<style>
    .spreadcell {
        width: 150px;
        height: 50px;
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;
        margin: 0;
        overflow: auto;
    }

    .table-container {
        overflow-x: auto;
    }

    .fixed-header {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #ffffff !important;
    }

    .fixed-column {
        position: sticky;
        left: 0;
        z-index: 1;
        background-color: #ffffff !important;
    }

    .scrollable {
        white-space: nowrap; /* Ensures no line breaks within cells */
        width: 1000px;
        height: 500px;
        margin: -1px;
    }

    .error-box {
        background-color: lightgray;
        position: fixed;
        padding: 30px;
        border: 1.5px solid black;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        text-align: center;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1000;
    }

    .error-button{
        background-color: crimson;
        color: white;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        text-align: center;
    }

    .error-button:hover {
        background-color: darkred;
    }

    .red-text {
        color: red;
    }

    .focus-outline {
        outline: 2px solid black;
        outline-offset: -2px;
    }
</style>


<script type="text/javascript">
    
    function focusElement(id) {
        console.log(`looking for: ${id}`);
        var element = document.getElementById(id);
        if (element) {
            console.log(`focusing element: ${id} ${element}`)
            element.focus();
        }
    }

    window.addKeyPressListener = function (dotNetObject) {
        console.log("registering key press event handler");
        document.addEventListener('keydown', function (event) {
            console.log(`got key: ${event.key}`);
            if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) {
                event.preventDefault(); // Prevent arrow keys from scrolling
            }
            dotNetObject.invokeMethodAsync('HandleKeyPress', event.key);
        });
    };

    function downloadFile(fileName, fileContent) {
        console.log(`download file ${fileName}`);
        // Create a blob with the file content
        const blob = new Blob([fileContent], { type: "text/plain" });

        // Create a link element
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = fileName;

        // Append the anchor element to the body
        document.body.appendChild(a);

        // Click the link to trigger download
        a.click();

        // Remove the anchor element from the DOM
        document.body.removeChild(a);
    }

</script>
